# ============================================================
# RISE HOTEL SNS自動投稿ツール - 環境変数サンプル
# このファイルをコピーして ".env" という名前で保存し、実際の値を入れてください。
# ".env" は絶対にGitにコミットしないでください（.gitignoreで除外済み）。
# 本番運用ではここに書かず、GitHub Secrets / Vercelの環境変数に設定します。
# ============================================================

# --- リポジトリ情報（画像生成・投稿バッチ処理が読み書きする対象） ---
GITHUB_REPO=your-github-username/rise-hotel-sns-tool
GITHUB_BRANCH=main

# --- Google Gemini API（画像生成 / Nano Banana 2） ---
GEMINI_API_KEY=
# モデルIDは変更される可能性があるため、必ず最新のGemini APIドキュメントで確認してから設定してください。
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_MAX_RETRIES=3

# --- X（旧Twitter）API v2 / OAuth1.0a（投稿用） ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Bearer Tokenはアプリ単体認証用のため、ユーザーとして投稿するこのツールでは使用しません（読み取り専用途向け・任意）。
X_BEARER_TOKEN=

# --- Meta（Instagram / Facebook）Graph API：審査承認後に使用 ---
META_ACCESS_TOKEN=
IG_USER_ID=17841479578862115
FACEBOOK_PAGE_ID=962108640309426
# feed=通常のページ投稿にフォールバック / story=ストーリー投稿を試みる
FACEBOOK_POST_MODE=feed

# --- Google Business Profile API：審査承認後に使用 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# --- 各SNSへの本番投稿を行うかどうかのスイッチ ---
# false のままだと実際には投稿されず、ログにのみ記録されます（dry-run）。
ENABLE_X=true
ENABLE_INSTAGRAM=false
ENABLE_FACEBOOK=false
ENABLE_GOOGLE_BUSINESS=false

# --- 失敗通知（任意） ---
SLACK_WEBHOOK_URL=

# --- 管理画面（Vercel）側でのみ使用。GitHub Actions側では設定不要 ---
# Contents の読み書き権限のみを持つ、このリポジトリ専用の fine-grained PAT
GITHUB_PAT=

# --- 管理画面のログイン機能（Vercel側でのみ使用） ---
# セッションCookieの署名に使うランダムな文字列。他人に推測されない値にすること。
# 生成例（ローカルで実行）: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# ユーザーアカウント（メールアドレス・パスワードのハッシュ値）の保存先。
# VercelダッシュボードのStorage/MarketplaceでUpstash(Redis)を追加しプロジェクトに接続すると
# 自動的に注入されるため、通常は自分で値を入力する必要はない。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
